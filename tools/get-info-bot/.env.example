# Tools_NNBot Configuration Example
# Copy this file to .env and fill in your values

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Required: List of authorized admin Telegram user IDs
# Get your ID from @userinfobot
# Format: [123456789,987654321]
ADMIN_IDS=[123456789]

# Optional: Custom welcome message (with MarkdownV2 escaping)
# WELCOME_MESSAGE="🤖 *Welcome to Tools\\_NNBot*\n\nYour custom message here\\."

# Optional: Rate limiting settings
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: HTTP client settings
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_WAIT_MIN=1.0
HTTP_RETRY_WAIT_MAX=10.0

# Optional: Logging settings
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional: Message length limit
MAX_RESPONSE_LENGTH=4096
